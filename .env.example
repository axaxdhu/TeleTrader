# Telegram API credentials.
# Create an application at https://my.telegram.org/apps to obtain these values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Login phone number in international format, e.g. +919876543210.
# Used for the initial interactive login that creates the session file.
TELEGRAM_PHONE=

# Name of the Telethon session file (without extension).
# A "<name>.session" file is created in the working directory on first login.
TELEGRAM_SESSION_NAME=teletrader

# Primary channel / chat to listen to (the full trading pipeline).
# Accepts a public @username, an invite-resolved title, or a numeric chat id.
# Example: @my_signals_channel
TELEGRAM_CHANNEL=

# Optional SECOND channel (parse-only): its messages are parsed and stored but
# NOT traded. Leave blank to run a single channel. Same id/username formats as
# above.
TELEGRAM_CHANNEL_2=

# Per-channel on/off switches (default: both on). Disable a channel to stop
# listening to it without removing its id. A channel with no id set is skipped
# regardless.
CHANNEL_1_ENABLED=true
CHANNEL_2_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# SQLite database file for stored signals (created on first run).
DATABASE_PATH=teletrader.db

# --- Trade engine (business logic; no broker integration) --------------------
# Master go/no-go switch. When false, every signal is rejected.
AUTO_TRADING=false

# Allow acting on a signal whose content was already seen (default: reject).
ALLOW_DUPLICATES=false

# Maximum number of trades the engine will green-light per (market) day.
MAX_TRADES_PER_DAY=10

# Number of LOTS to trade per accepted signal. The engine multiplies this by the
# underlying's lot size to get the order quantity (lots x lot_size).
TRADE_LOTS=1

# Exchange lot size per underlying, as SYM:size pairs. These are set by the
# exchange (NSE) and revised periodically, and differ per underlying — set them
# to the CURRENT values. If an underlying is missing here, its signals are
# rejected (fail-closed) rather than sized with a guess. (Later this can be
# sourced automatically from the broker's instrument list — see src/teletrader/
# lot_size.py.)
LOT_SIZES=NIFTY:65,BANKNIFTY:30

# Trading-hours window (24h HH:MM) and the timezone they are interpreted in.
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_TIMEZONE=Asia/Kolkata

# --- Order execution ---------------------------------------------------------
# Which broker handles orders, as a GLOBAL default. Values:
#   dry_run  — validate + log exactly what would be submitted, record to SQLite;
#              sends nothing to any broker (used to validate the pipeline).
#   kite     — submit LIVE orders to Zerodha Kite (requires the KITE_* values).
#   fyers    — submit LIVE orders to FYERS (requires the FYERS_* values).
EXECUTION_MODE=dry_run

# Per-channel broker override (optional). Each channel can route to its own
# broker independently; leave blank to use EXECUTION_MODE above. Same values as
# EXECUTION_MODE (dry_run / kite / fyers). Example: run channel 1 on Kite and
# channel 2 on FYERS with CHANNEL_1_BROKER=kite and CHANNEL_2_BROKER=fyers.
CHANNEL_1_BROKER=
CHANNEL_2_BROKER=

# --- Zerodha Kite Connect (only needed when a channel uses the kite broker) ---
# Authentication is MANUAL: this app assumes a valid access token already exists.
# It never logs in for you. The access token expires every morning (~6 AM IST);
# regenerate it daily with the helper:  uv run python kite_login.py
# (it prints the login URL, you log in in the browser, paste the request_token
# back, and it writes KITE_ACCESS_TOKEN here). Secrets are never logged.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- FYERS (only needed when a channel uses the fyers broker) -----------------
# Create an app at https://myapi.fyers.in (App ID, Secret ID, Redirect URI). The
# redirect URI must match the login helper's callback (default
# http://localhost:8765). Authentication is MANUAL: this app assumes a valid
# daily access token already exists — it never logs in for you. FYERS tokens
# expire daily; regenerate one with:  uv run python fyers_login.py
# NOTE: live FYERS order placement requires your public IP to be whitelisted in
# the FYERS app's "Static IP" setting (use a fixed IP / cloud host). Secrets are
# never logged.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_ACCESS_TOKEN=

# --- Telegram bot notifications (optional) -----------------------------------
# Push alerts (recognised signal + outcome — placed / dry-run / not-traded /
# management results / failures) sent to you via a Telegram BOT. A bot is used
# because Telegram notifies you for a bot's messages but not for your own.
# Setup: create a bot with @BotFather (gives NOTIFY_BOT_TOKEN), send it /start,
# then get your NOTIFY_CHAT_ID. Off unless NOTIFY_ENABLED=true. The token is a
# secret (never logged/committed).
NOTIFY_ENABLED=false
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=
