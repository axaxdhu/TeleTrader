# Telegram API credentials.
# Create an application at https://my.telegram.org/apps to obtain these values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Login phone number in international format, e.g. +919876543210.
# Used for the initial interactive login that creates the session file.
TELEGRAM_PHONE=

# Name of the Telethon session file (without extension).
# A "<name>.session" file is created in the working directory on first login.
TELEGRAM_SESSION_NAME=teletrader

# Channel / chat to listen to.
# Accepts a public @username, an invite-resolved title, or a numeric chat id.
# Example: @my_signals_channel
TELEGRAM_CHANNEL=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
