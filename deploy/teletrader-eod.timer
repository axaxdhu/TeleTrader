[Unit]
Description=Run the TeleTrader end-of-day summary after the close

[Timer]
# 15:35 IST on weekdays, five minutes after the 15:30 close. The timezone is
# given inline on OnCalendar (systemd >= 252): there is no `Timezone=` key, and
# systemd silently ignores unknown keys — so writing one would have scheduled
# this at 15:35 UTC, i.e. 21:05 IST, hours after the market shut.
# Verify with: systemd-analyze calendar "Mon..Fri 15:35 Asia/Kolkata"
OnCalendar=Mon..Fri 15:35 Asia/Kolkata
# If the box was down at 15:35, still send the summary once it is back.
Persistent=true

[Install]
WantedBy=timers.target
